<Window x:Class="CutPic.ExportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="导出前总览" Width="1040" Height="760" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppCanvasBrush}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource MaterialDesign.Brush.Primary}" materialDesign:ElevationAssist.Elevation="Dp3">
      <DockPanel Margin="22,0">
        <materialDesign:PackIcon Kind="ImageMultipleOutline" Width="27" Height="27" Foreground="White" VerticalAlignment="Center"/>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="导出前总览" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
          <TextBlock x:Name="SummaryText" Foreground="#CFFFFFFF" FontSize="11"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18">
      <ItemsControl x:Name="PreviewItems">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <materialDesign:Card Width="220" Margin="7" Padding="10" Background="{StaticResource AppSurfaceBrush}" UniformCornerRadius="9">
              <StackPanel>
                <Grid Height="156" Background="{StaticResource TransparencyCheckerBrush}">
                  <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="5"/>
                  <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5"/>
                </Grid>
                <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                           FontWeight="SemiBold" Margin="2,8,2,2" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="2,0"/>
                <TextBlock Text="{Binding Warning}" Foreground="#FFFFB74D" FontSize="11" TextWrapping="Wrap" Margin="2,4,2,0"/>
              </StackPanel>
            </materialDesign:Card>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <Border Grid.Row="2" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
      <DockPanel Margin="18,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="全选" Click="SelectAll_Click" Style="{StaticResource MaterialDesignFlatButton}"/>
          <Button Content="全部取消" Click="SelectNone_Click" Style="{StaticResource MaterialDesignFlatButton}"/>
          <Button Content="仅选择无警告项" Click="SelectSafe_Click" Style="{StaticResource MaterialDesignFlatButton}"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="返回" Click="Cancel_Click" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0"/>
          <Button Content="确认并导出" Click="Confirm_Click" Style="{StaticResource MaterialDesignRaisedButton}" Padding="18,8"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
