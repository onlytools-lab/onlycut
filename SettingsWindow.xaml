<Window x:Class="CutPic.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="CutPic 设置" Width="780" Height="720" MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource AppCanvasBrush}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="68"/></Grid.RowDefinitions>

    <Border Background="{DynamicResource MaterialDesign.Brush.Primary}" materialDesign:ElevationAssist.Elevation="Dp3">
      <DockPanel Margin="22,0">
        <materialDesign:PackIcon Kind="CogOutline" Width="26" Height="26" Foreground="White" VerticalAlignment="Center"/>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="应用设置" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
          <TextBlock Text="管理不需要频繁调整的默认选项" FontSize="11" Foreground="#CFFFFFFF"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*" MinWidth="420"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
        <ListBox x:Name="SettingsNavigation" SelectedIndex="0" SelectionChanged="SettingsNavigation_SelectionChanged"
                 Background="Transparent" BorderThickness="0" Padding="10,14">
          <ListBoxItem Content="导出与命名" Padding="14,11"/>
          <ListBoxItem Content="工作区与恢复" Padding="14,11"/>
          <ListBoxItem Content="快捷键" Padding="14,11"/>
          <ListBoxItem Content="外观与语言" Padding="14,11"/>
          <ListBoxItem Content="关于" Padding="14,11"/>
        </ListBox>
      </Border>

      <Grid Grid.Column="1">
        <ScrollViewer x:Name="ExportSettingsPage" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24,20">
            <TextBlock Text="导出默认值" Style="{StaticResource PanelHeader}"/>
            <materialDesign:Card Padding="18" Margin="0,0,0,18" Background="{StaticResource AppSurfaceBrush}" UniformCornerRadius="10">
              <StackPanel>
                <ComboBox x:Name="ConflictPolicyBox" materialDesign:HintAssist.Hint="文件重名处理" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,14">
                  <ComboBoxItem Content="自动追加序号"/><ComboBoxItem Content="覆盖已有文件"/><ComboBoxItem Content="跳过已有文件"/>
                </ComboBox>
                <DockPanel><TextBlock Text="JPG 默认质量"/><TextBlock x:Name="QualityText" DockPanel.Dock="Right" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"/></DockPanel>
                <Slider x:Name="QualitySlider" Minimum="50" Maximum="100" TickFrequency="1" ValueChanged="QualitySlider_ValueChanged" Margin="0,2,0,10"/>
                <CheckBox x:Name="CreateSourceSubfolderBox" Content="按源图片创建子文件夹" Margin="0,4"/>
                <CheckBox x:Name="OpenFolderAfterExportBox" Content="导出完成后打开文件夹" Margin="0,4"/>
              </StackPanel>
            </materialDesign:Card>

            <TextBlock Text="文件命名" Style="{StaticResource PanelHeader}"/>
            <materialDesign:Card Padding="18" Background="{StaticResource AppSurfaceBrush}" UniformCornerRadius="10">
              <StackPanel>
                <ComboBox x:Name="NamingModeBox" materialDesign:HintAssist.Hint="名称来源" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,12" SelectionChanged="NamingModeBox_SelectionChanged">
                  <ComboBoxItem Content="使用原文件名"/><ComboBoxItem Content="使用自定义前缀"/>
                </ComboBox>
                <UniformGrid Columns="2">
                  <TextBox x:Name="NamingPrefixBox" materialDesign:HintAssist.Hint="自定义前缀" Style="{StaticResource CompactOutlinedTextBox}"/>
                  <TextBox x:Name="NamingSuffixBox" materialDesign:HintAssist.Hint="附加后缀" Style="{StaticResource CompactOutlinedTextBox}" Margin="6,5,0,8"/>
                  <TextBox x:Name="NamingStartNumberBox" materialDesign:HintAssist.Hint="起始编号" Style="{StaticResource CompactOutlinedTextBox}"/>
                  <ComboBox x:Name="NamingDigitsBox" materialDesign:HintAssist.Hint="编号位数" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="6,5,0,8">
                    <ComboBoxItem Content="2 位"/><ComboBoxItem Content="3 位"/><ComboBoxItem Content="4 位"/>
                  </ComboBox>
                </UniformGrid>
              </StackPanel>
            </materialDesign:Card>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="WorkspaceSettingsPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel Margin="24,20">
            <TextBlock Text="工作区与恢复" Style="{StaticResource PanelHeader}"/>
            <materialDesign:Card Padding="18" Background="{StaticResource AppSurfaceBrush}" UniformCornerRadius="10">
              <StackPanel>
                <CheckBox x:Name="AutoRestoreBox" Content="启动时自动恢复上次会话" Margin="0,4,0,12"/>
                <TextBox x:Name="AutoSaveIntervalBox" materialDesign:HintAssist.Hint="自动保存间隔（秒）" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                <TextBlock Text="允许范围 5–300 秒。项目恢复文件保存在当前用户的本地应用数据目录。" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="2,7,0,0"/>
              </StackPanel>
            </materialDesign:Card>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ShortcutSettingsPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel Margin="24,20">
            <DockPanel Margin="4,0,0,10" LastChildFill="False">
              <TextBlock Text="快捷键" Style="{StaticResource PanelHeader}" VerticalAlignment="Center"/>
              <Button DockPanel.Dock="Right" Content="恢复默认快捷键" Click="ResetShortcuts_Click" Style="{StaticResource MaterialDesignFlatButton}" Padding="10,4"/>
            </DockPanel>
            <materialDesign:Card Padding="18,10" Background="{StaticResource AppSurfaceBrush}" UniformCornerRadius="10">
              <StackPanel>
                <TextBlock Text="点击快捷键输入框，然后按下新的按键组合。单键快捷键在文本输入时不会触发。"
                           FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,10"/>
                <StackPanel x:Name="ShortcutListPanel"/>
              </StackPanel>
            </materialDesign:Card>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="AppearanceSettingsPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel Margin="24,20">
            <TextBlock Text="外观与语言" Style="{StaticResource PanelHeader}"/>
            <materialDesign:Card Padding="18" Background="{StaticResource AppSurfaceBrush}" UniformCornerRadius="10">
              <StackPanel>
                <ComboBox x:Name="LanguageBox" materialDesign:HintAssist.Hint="界面语言" Margin="0,0,0,14" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                  <ComboBoxItem Content="简体中文" Tag="zh-CN"/><ComboBoxItem Content="English" Tag="en-US"/>
                </ComboBox>
                <ComboBox x:Name="FontFamilyBox" materialDesign:HintAssist.Hint="界面字体" Style="{StaticResource MaterialDesignOutlinedComboBox}" SelectionChanged="FontFamilyBox_SelectionChanged">
                  <ComboBoxItem Content="跟随 Windows 系统" Tag="System"/>
                  <ComboBoxItem Content="Microsoft YaHei UI（微软雅黑）" Tag="Microsoft YaHei UI"/>
                  <ComboBoxItem Content="Segoe UI" Tag="Segoe UI"/><ComboBoxItem Content="Arial" Tag="Arial"/>
                  <ComboBoxItem Content="Roboto" Tag="Roboto"/><ComboBoxItem Content="HarmonyOS Sans SC" Tag="HarmonyOS Sans SC"/>
                </ComboBox>
                <TextBlock Text="字体会应用到主窗口和设置窗口；图标与图片内容不受影响。" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="2,7,0,0"/>
              </StackPanel>
            </materialDesign:Card>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="AboutSettingsPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel Margin="24,20">
            <TextBlock Text="关于 CutPic" Style="{StaticResource PanelHeader}"/>
            <materialDesign:Card Padding="24" Background="{StaticResource AppSurfaceBrush}" UniformCornerRadius="10">
              <StackPanel HorizontalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource MaterialDesign.Brush.Primary}" Margin="0,4,0,14">
                  <materialDesign:PackIcon Kind="Crop" Width="34" Height="34" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="CutPic" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="AppVersionText" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,16" HorizontalAlignment="Center"/>
                <TextBlock Text="轻量的智能宫格、素材与长图切分工具" TextWrapping="Wrap" TextAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                  <Button Content="打开日志文件夹" Click="OpenLogsFolder_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,6,0"/>
                  <Button Content="导出诊断包" Click="ExportDiagnostics_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="6,0,0,0"/>
                </StackPanel>
                <TextBlock Text="诊断包不包含用户图片或项目文件。" FontSize="11" Foreground="{StaticResource MutedBrush}"
                           TextAlignment="Center" Margin="0,12,0,0"/>
              </StackPanel>
            </materialDesign:Card>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
      <DockPanel Margin="18,0">
        <Button Content="恢复本页默认值" Click="Reset_Click" Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="取消" Click="Cancel_Click" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0"/>
          <Button Content="保存设置" Click="Save_Click" Style="{StaticResource MaterialDesignRaisedButton}" Padding="18,8"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
