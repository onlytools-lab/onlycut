<Window x:Class="CutPic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="CutPic · 智能切图" Width="1500" Height="920" MinWidth="1120" MinHeight="700"
        Background="{StaticResource AppCanvasBrush}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        FontFamily="pack://application:,,,/MaterialDesignThemes.Wpf;component/Resources/Roboto/#Roboto"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="64"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="38"/>
    </Grid.RowDefinitions>

    <!-- App bar -->
    <Border Grid.Row="0" Background="{DynamicResource MaterialDesign.Brush.Primary}" materialDesign:ElevationAssist.Elevation="Dp4">
      <DockPanel Margin="18,0,12,0" LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
          <Border Width="38" Height="38" CornerRadius="10" Background="#26FFFFFF" Margin="0,0,12,0">
            <materialDesign:PackIcon Kind="Crop" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="CutPic" FontSize="19" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="智能宫格与素材切图" FontSize="11" Foreground="#CFFFFFFF"/>
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource TopActionButton}" Click="Open_Click" ToolTip="添加图片">
            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FolderOpen"/><TextBlock Text="添加图片" Margin="7,0,0,0"/></StackPanel>
          </Button>
          <Button Style="{StaticResource TopActionButton}" Click="Detect_Click" ToolTip="按当前参数重新识别">
            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="AutoFix"/><TextBlock Text="自动识别" Margin="7,0,0,0"/></StackPanel>
          </Button>
          <Button Style="{StaticResource TopActionButton}" Click="AddRegion_Click" ToolTip="添加选框">
            <materialDesign:PackIcon Kind="SelectionDrag"/>
          </Button>
          <Button Style="{StaticResource TopActionButton}" Click="DeleteRegion_Click" ToolTip="删除选框">
            <materialDesign:PackIcon Kind="DeleteOutline"/>
          </Button>
          <Button Style="{StaticResource TopActionButton}" Click="Undo_Click" ToolTip="撤销 Ctrl+Z"><materialDesign:PackIcon Kind="Undo"/></Button>
          <Button Style="{StaticResource TopActionButton}" Click="Redo_Click" ToolTip="重做 Ctrl+Y"><materialDesign:PackIcon Kind="Redo"/></Button>
          <Button Click="Export_Click" Style="{StaticResource MaterialDesignRaisedButton}" Margin="12,0,0,0" Padding="18,10"
                  Background="{DynamicResource MaterialDesign.Brush.Secondary}" Foreground="#19111A">
            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Export"/><TextBlock Text="导出全部" Margin="8,0,0,0" FontWeight="SemiBold"/></StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="248"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="372"/>
      </Grid.ColumnDefinitions>

      <!-- Task rail -->
      <Border Grid.Column="0" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="14">
          <StackPanel DockPanel.Dock="Top">
            <DockPanel Margin="4,4,4,12" LastChildFill="False">
              <TextBlock Text="图片任务" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Click="Open_Click" Style="{StaticResource MaterialDesignIconButton}" ToolTip="添加任务"><materialDesign:PackIcon Kind="Plus"/></Button>
                <Button Click="RemoveTask_Click" Style="{StaticResource MaterialDesignIconButton}" ToolTip="移除任务"><materialDesign:PackIcon Kind="Close"/></Button>
              </StackPanel>
            </DockPanel>
            <Border Background="#15FFFFFF" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
              <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="InformationOutline" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
                <TextBlock Text="支持拖入多张图片" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
              </StackPanel>
            </Border>
          </StackPanel>
          <ListBox x:Name="TaskList" Background="Transparent" BorderThickness="0" SelectionChanged="TaskList_SelectionChanged"
                   DisplayMemberPath="Name" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </DockPanel>
      </Border>

      <!-- Canvas -->
      <Grid Grid.Column="1" Background="{StaticResource AppCanvasBrush}">
        <materialDesign:Card Margin="16" Background="#090C12" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2">
          <Grid>
            <ScrollViewer x:Name="ImageScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel">
              <Grid x:Name="ImageHost" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28" RenderTransformOrigin="0,0">
                <Grid.LayoutTransform><ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/></Grid.LayoutTransform>
                <Image x:Name="SourceImage" Stretch="None"/>
                <Canvas x:Name="Overlay" Background="Transparent" MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
                        MouseMove="Overlay_MouseMove" MouseLeftButtonUp="Overlay_MouseLeftButtonUp"/>
              </Grid>
            </ScrollViewer>

            <materialDesign:Card HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"
                                 Background="{StaticResource AppSurfaceHighBrush}" UniformCornerRadius="20" materialDesign:ElevationAssist.Elevation="Dp4">
              <StackPanel Orientation="Horizontal" Margin="4">
                <Button Click="ZoomOut_Click" Style="{StaticResource MaterialDesignIconButton}" ToolTip="缩小"><materialDesign:PackIcon Kind="Minus"/></Button>
                <Button x:Name="ZoomTextButton" Content="100%" Click="ZoomReset_Click" Style="{StaticResource MaterialDesignFlatButton}" MinWidth="64"/>
                <Button Click="ZoomIn_Click" Style="{StaticResource MaterialDesignIconButton}" ToolTip="放大"><materialDesign:PackIcon Kind="Plus"/></Button>
              </StackPanel>
            </materialDesign:Card>

            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
              <materialDesign:PackIcon Kind="ImageMultipleOutline" Width="54" Height="54" Foreground="#394252" HorizontalAlignment="Center"/>
              <TextBlock Text="拖入图片开始切图" Foreground="#687285" FontSize="15" Margin="0,12,0,0"/>
            </StackPanel>
          </Grid>
        </materialDesign:Card>
      </Grid>

      <!-- Properties -->
      <Border Grid.Column="2" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="18">
            <TextBlock Text="工作模式" Style="{StaticResource PanelHeader}"/>
            <ComboBox x:Name="WorkModeBox" SelectedIndex="0" materialDesign:HintAssist.Hint="当前工作流"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,16"
                      SelectionChanged="WorkModeBox_SelectionChanged">
              <ComboBoxItem Content="智能元素切图"/>
              <ComboBoxItem Content="长图纵向切分"/>
            </ComboBox>
            <TextBlock Text="成品预览" Style="{StaticResource PanelHeader}"/>
            <materialDesign:Card Height="250" Background="#0C1017" UniformCornerRadius="12" Margin="0,0,0,16" materialDesign:ElevationAssist.Elevation="Dp2">
              <Image x:Name="OutputPreview" Stretch="Uniform" Margin="12"/>
            </materialDesign:Card>

            <Expander x:Name="RecognitionExpander" Header="识别设置" IsExpanded="True" Style="{StaticResource MaterialDesignExpander}">
              <StackPanel Margin="8,8,8,14">
                <ComboBox x:Name="DetectionModeBox" SelectedIndex="0" materialDesign:HintAssist.Hint="识别模式" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,4,0,12">
                  <ComboBoxItem Content="自动选择模式"/><ComboBoxItem Content="有边界卡片"/><ComboBoxItem Content="无边界元素"/>
                </ComboBox>
                <DockPanel Margin="0,4,0,2" LastChildFill="False"><TextBlock Text="颜色灵敏度"/><TextBlock x:Name="SensitivityText" Text="60" DockPanel.Dock="Right" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"/></DockPanel>
                <Slider x:Name="SensitivitySlider" Minimum="10" Maximum="95" Value="60" TickFrequency="1" ValueChanged="DetectionSlider_ValueChanged" Margin="0,0,0,8"/>
                <DockPanel Margin="0,4,0,2" LastChildFill="False"><TextBlock Text="碎片合并距离"/><TextBlock x:Name="GroupingText" Text="40" DockPanel.Dock="Right" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"/></DockPanel>
                <Slider x:Name="GroupingSlider" Minimum="2" Maximum="80" Value="40" TickFrequency="1" ValueChanged="DetectionSlider_ValueChanged" Margin="0,0,0,10"/>
                <UniformGrid Columns="2">
                  <TextBox x:Name="MinimumAreaBox" Text="0.06" materialDesign:HintAssist.Hint="最小面积 %" Style="{StaticResource CompactOutlinedTextBox}"/>
                  <TextBox x:Name="ObjectPaddingBox" Text="18" materialDesign:HintAssist.Hint="留白 px" Style="{StaticResource CompactOutlinedTextBox}" Margin="6,5,0,8"/>
                </UniformGrid>
                <Button Content="应用识别参数" Click="Detect_Click" Style="{StaticResource MaterialDesignOutlinedButton}" HorizontalAlignment="Stretch"/>
              </StackPanel>
            </Expander>

            <Expander x:Name="LongImageExpander" Header="长图切分" IsExpanded="True"
                      Style="{StaticResource MaterialDesignExpander}" Visibility="Collapsed">
              <StackPanel Margin="8,8,8,14">
                <ComboBox x:Name="LongSplitModeBox" SelectedIndex="0" materialDesign:HintAssist.Hint="切分方式"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,4,0,12"
                          SelectionChanged="LongSplitModeBox_SelectionChanged">
                  <ComboBoxItem Content="按数量平均切分"/>
                  <ComboBoxItem Content="按固定高度切分"/>
                  <ComboBoxItem Content="自定义每段高度"/>
                </ComboBox>
                <TextBox x:Name="LongCountBox" Text="3" materialDesign:HintAssist.Hint="平均切片数量"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>
                <TextBox x:Name="LongFixedHeightBox" Text="1200" materialDesign:HintAssist.Hint="固定高度 px"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>
                <TextBox x:Name="LongCustomHeightsBox" Text="800&#x0a;1200&#x0a;950" AcceptsReturn="True" MinHeight="92"
                         VerticalScrollBarVisibility="Auto" materialDesign:HintAssist.Hint="自定义高度（每行一个）"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>
                <TextBlock Text="最后一段始终使用剩余高度；切片之间无间距，宽度始终为原图 100%。"
                           Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="2,0,2,10"/>
                <Button Content="生成长图切片" Click="GenerateLongSlices_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Stretch"/>
              </StackPanel>
            </Expander>

            <Expander Header="输出设置" IsExpanded="True" Style="{StaticResource MaterialDesignExpander}">
              <StackPanel Margin="8,8,8,14">
                <ComboBox x:Name="SizeBox" SelectedIndex="1" materialDesign:HintAssist.Hint="输出尺寸" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,4,0,12">
                  <ComboBoxItem Content="保持最大边尺寸" Tag="0"/><ComboBoxItem Content="512 × 512" Tag="512"/>
                  <ComboBoxItem Content="800 × 800" Tag="800"/><ComboBoxItem Content="1024 × 1024" Tag="1024"/>
                </ComboBox>
                <ComboBox x:Name="FormatBox" SelectedIndex="0" materialDesign:HintAssist.Hint="文件格式" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,12">
                  <ComboBoxItem Content="PNG"/><ComboBoxItem Content="JPG"/>
                </ComboBox>
                <DockPanel LastChildFill="False"><TextBlock Text="JPG 质量"/><TextBlock x:Name="QualityText" Text="92" DockPanel.Dock="Right" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"/></DockPanel>
                <Slider x:Name="QualitySlider" Minimum="50" Maximum="100" Value="92" TickFrequency="1" ValueChanged="QualitySlider_ValueChanged" Margin="0,0,0,8"/>
                <CheckBox x:Name="AutoBackgroundBox" Content="自动采样卡片底色" IsChecked="True" Margin="0,4"/>
                <CheckBox x:Name="CleanCornersBox" Content="自动清理圆角背景" IsChecked="True" IsEnabled="False" Margin="0,4"/>
              </StackPanel>
            </Expander>

            <Expander x:Name="FixedGridExpander" Header="固定宫格" Style="{StaticResource MaterialDesignExpander}">
              <StackPanel Margin="8,8,8,14">
                <UniformGrid Columns="2">
                  <TextBox x:Name="RowsBox" Text="3" materialDesign:HintAssist.Hint="行数" Style="{StaticResource CompactOutlinedTextBox}"/>
                  <TextBox x:Name="ColumnsBox" Text="3" materialDesign:HintAssist.Hint="列数" Style="{StaticResource CompactOutlinedTextBox}" Margin="6,5,0,8"/>
                  <TextBox x:Name="MarginXBox" Text="24" materialDesign:HintAssist.Hint="横向边距" Style="{StaticResource CompactOutlinedTextBox}"/>
                  <TextBox x:Name="MarginYBox" Text="24" materialDesign:HintAssist.Hint="纵向边距" Style="{StaticResource CompactOutlinedTextBox}" Margin="6,5,0,8"/>
                  <TextBox x:Name="GapXBox" Text="18" materialDesign:HintAssist.Hint="横向间距" Style="{StaticResource CompactOutlinedTextBox}"/>
                  <TextBox x:Name="GapYBox" Text="18" materialDesign:HintAssist.Hint="纵向间距" Style="{StaticResource CompactOutlinedTextBox}" Margin="6,5,0,8"/>
                </UniformGrid>
                <Button Content="按参数生成选框" Click="GenerateGrid_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,2,0,8"/>
                <Button Content="从识别结果推算" Click="InferGrid_Click" Style="{StaticResource MaterialDesignFlatButton}"/>
              </StackPanel>
            </Expander>

            <Expander Header="当前选框" Style="{StaticResource MaterialDesignExpander}">
              <UniformGrid Columns="2" Margin="8,12,8,16">
                <TextBox x:Name="XBox" materialDesign:HintAssist.Hint="X" Style="{StaticResource CompactOutlinedTextBox}" LostFocus="BoundsBox_LostFocus"/>
                <TextBox x:Name="YBox" materialDesign:HintAssist.Hint="Y" Style="{StaticResource CompactOutlinedTextBox}" Margin="6,5,0,8" LostFocus="BoundsBox_LostFocus"/>
                <TextBox x:Name="WidthBox" materialDesign:HintAssist.Hint="宽度" Style="{StaticResource CompactOutlinedTextBox}" LostFocus="BoundsBox_LostFocus"/>
                <TextBox x:Name="HeightBox" materialDesign:HintAssist.Hint="高度" Style="{StaticResource CompactOutlinedTextBox}" Margin="6,5,0,8" LostFocus="BoundsBox_LostFocus"/>
              </UniformGrid>
            </Expander>

            <Border Background="#12FFFFFF" CornerRadius="8" Padding="12" Margin="0,14,0,8">
              <TextBlock Text="拖动选框移动 · 右下角缩放 · 滚轮缩放画布 · Delete 删除 · Ctrl+Z 撤销"
                         Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="20"/>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource AppSurfaceHighBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
      <DockPanel Margin="16,0" LastChildFill="False">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="7" Height="7" Fill="{DynamicResource MaterialDesign.Brush.Secondary}" Margin="0,0,8,0"/>
          <TextBlock x:Name="StatusText" Text="请添加或拖入图片" FontSize="12"/>
        </StackPanel>
        <TextBlock x:Name="ImageInfoText" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
