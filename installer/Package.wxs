<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="CutPic" Manufacturer="CutPic" Version="$(var.ProductVersion)" Language="2052"
           UpgradeCode="6E02C1AA-9A9D-4CB1-8F6F-37AD338F316A" Scope="perMachine">
    <SummaryInformation Description="CutPic 智能切图工具" Manufacturer="CutPic"/>
    <MajorUpgrade DowngradeErrorMessage="已安装更新版本的 CutPic。"/>
    <!-- Detect only: do not uninstall or migrate an equal-version product. -->
    <Upgrade Id="6E02C1AA-9A9D-4CB1-8F6F-37AD338F316A">
      <UpgradeVersion Minimum="$(var.ProductVersion)" Maximum="$(var.ProductVersion)"
                      IncludeMinimum="yes" IncludeMaximum="yes" OnlyDetect="yes"
                      Property="ONLYCUT_SAME_VERSION_FOUND"/>
    </Upgrade>
    <Launch Condition="Installed OR NOT ONLYCUT_SAME_VERSION_FOUND"
            Message="ONLYCUT_SAME_VERSION_BLOCKED: 已安装相同版本的 CutPic。请使用已安装产品的维护入口，或安装更高版本。"/>
    <MediaTemplate EmbedCab="yes" CompressionLevel="high"/>
    <Icon Id="CutPicIcon" SourceFile="$(var.RootDir)\CutPic.ico"/>
    <Property Id="ARPPRODUCTICON" Value="CutPicIcon"/>
    <Property Id="ARPNOREPAIR" Value="1"/>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="CutPic"/>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuCutPicFolder" Name="CutPic"/>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder"/>

    <Feature Id="MainFeature" Title="CutPic" Level="1">
      <ComponentGroupRef Id="ApplicationFiles"/>
      <ComponentRef Id="ProgramMenuShortcut"/>
      <ComponentRef Id="DesktopShortcut"/>
    </Feature>

    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**"/>
    </ComponentGroup>

    <Component Id="ProgramMenuShortcut" Directory="ProgramMenuCutPicFolder" Guid="*">
      <Shortcut Id="ProgramMenuShortcutLink" Name="CutPic" Description="CutPic 智能切图"
                Target="[INSTALLFOLDER]CutPic.exe" WorkingDirectory="INSTALLFOLDER" Icon="CutPicIcon"/>
      <RemoveFolder Id="RemoveProgramMenuFolder" Directory="ProgramMenuCutPicFolder" On="uninstall"/>
      <RegistryValue Root="HKCU" Key="Software\CutPic" Name="ProgramMenuShortcut" Type="integer" Value="1" KeyPath="yes"/>
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="*">
      <Shortcut Id="DesktopShortcutLink" Name="CutPic" Description="CutPic 智能切图"
                Target="[INSTALLFOLDER]CutPic.exe" WorkingDirectory="INSTALLFOLDER" Icon="CutPicIcon"/>
      <RegistryValue Root="HKCU" Key="Software\CutPic" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes"/>
    </Component>
  </Package>
</Wix>
